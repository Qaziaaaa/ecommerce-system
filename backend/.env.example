# PORT: The port number the backend server will listen on.
PORT=5001

# MONGO_URI: The connection string for your MongoDB database.
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dbname

# JWT Secrets: Used for authentication. Generate long, random strings.
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=90d

# Node Environment: 'development' or 'production'.
NODE_ENV=production

# EmailJS Configuration: For sending automated emails.
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key

# CORS: Comma-separated list of allowed frontend origins.
# Example for Vercel: https://your-app.vercel.app
# You can add multiple: https://your-app.vercel.app,https://www.yourdomain.com
CORS_ORIGIN=https://your-app.vercel.app

# Cloudinary Configuration: For image hosting.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=your_cloudinary_url

# Stripe Configuration: For payment processing.
STRIPE_SECRET_KEY=sk_test_your_secret_key

# Security Configuration: CSRF double-submit cookie token secret.
CSRF_SECRET=your_csrf_secret_here
