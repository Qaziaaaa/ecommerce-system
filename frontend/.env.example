# VITE_API_URL: The base URL for the backend API.
# Local development:
VITE_API_URL=http://localhost:5001/api/v1

# Production (Render deployment) — set this in Vercel dashboard:
# VITE_API_URL=https://your-app-name.onrender.com/api/v1

# VITE_STRIPE_PUBLIC_KEY: Your Stripe publishable key.
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here

# VITE_APP_URL: The URL where the frontend is hosted.
VITE_APP_URL=http://localhost:5173

# VITE_SENTRY_DSN: Sentry DSN for frontend error monitoring.
# Get your DSN from https://sentry.io
VITE_SENTRY_DSN=
