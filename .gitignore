# Root .gitignore for Combined MERN Monorepo

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env

# Build Outputs
backend/dist/
frontend/dist/
frontend/build/
.next/
out/
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/logs/
backend/*.log
backend/error.log
backend/startup.log
backend/final_startup.log

# IDE / System
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Testing
frontend/coverage/
backend/coverage/
frontend/playwright-report/
frontend/test-results/

# Misc
frontend/lint_output.txt
frontend/metadata.json
backend/test-*.js
backend/verify-*.js
